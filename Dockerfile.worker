FROM node:20-bookworm-slim
WORKDIR /app
COPY package.json ./
RUN npm install --omit=dev
COPY . .
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip python3-venv libgl1 libegl1 && rm -rf /var/lib/apt/lists/*
RUN python3 -m pip install --break-system-packages -r simulation/requirements.txt
ENV NODE_ENV=production
CMD ["node","worker.js"]
